# Copy to .env and adjust. Never commit the real .env file.

ATLAS_ENVIRONMENT=development
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas

ATLAS_SESSION_SECRET=change-me
ATLAS_SESSION_TTL_SECONDS=28800

# ADR-003: enable only for local development, never in production.
ATLAS_ENABLE_DEVELOPMENT_IDENTITY=true

# ATLAS-030 Section 6.1: leave unset until an enterprise LDAP/AD server is available.
# ATLAS_LDAP_URL=ldaps://directory.example.internal:636
# ATLAS_LDAP_BASE_DN=dc=example,dc=internal
# ATLAS_LDAP_BIND_DN=cn=atlas-service,dc=example,dc=internal
# ATLAS_LDAP_BIND_PASSWORD=
